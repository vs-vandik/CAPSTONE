# LLM Provider — DigitalOcean Serverless Inference
# Create a model access key at:
#   https://cloud.digitalocean.com/inference (Model Access Keys)
# Make sure the key has access to both the chat model and embedding model
# below. Tier 1 accounts get $25 of free monthly usage.
MODEL_ACCESS_KEY=

# Inference endpoint. Override to swap providers (e.g. https://api.openai.com/v1
# with an OpenAI key in MODEL_ACCESS_KEY).
LLM_BASE_URL=https://inference.do-ai.run/v1/

# Chat model used for every expert turn.
# Other reasonable choices on DO: openai-gpt-4o-mini (cheaper, similar quality),
# llama3.3-70b-instruct (DO-hosted, open weights), openai-gpt-5-mini.
LLM_MODEL=anthropic-claude-haiku-4.5

# Embedding model used for retrieval. Qwen3 0.6B is multilingual (works for
# Marx in German and Caesar in Latin if/when those corpora are added) and
# has an 8000-token context window. EMBEDDING_DIM must match the model:
#   qwen3-embedding-0.6b -> 1024
#   bge-m3                -> 1024
# Switching models requires rebuilding every persona's embeddings.npy.
EMBEDDING_MODEL=qwen3-embedding-0.6b
EMBEDDING_DIM=1024

TEMPERATURE=0.7
MAX_TOKENS=500

# News Grounding (optional - debates work without it)
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5

# Knowledge Base
DATA_DIR=./data

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# CORS (comma-separated origins; * is rejected for safety)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Audio Settings
ENABLE_TTS=true
DEFAULT_VOICE=en-US-AriaNeural
